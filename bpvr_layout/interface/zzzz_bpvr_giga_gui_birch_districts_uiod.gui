                size = { x = 315 y = -10 }
                alwaysTransparent = yes
            }
            # Buildings
            gridBoxType = {
                name = "buildings_box"
                position = { x = 0 y = 0 }
                size = { width = 205 height = -10 }
                format = "UPPER_LEFT"
                slotSize = { width = 52 height = 53 }
                add_horizontal = yes
                max_slots_horizontal = 6
                #max_slots_vertical = 2
            }
            iconType = {
                name = "progressbar"
                spriteType = "GFX_zone_smaller_progressbar"
                position = { x = 5 y = 48 }
                alwaysTransparent = yes
            }
            buttonType = {
                name = "zone_button"
                spriteType = "GFX_new_zone"
                position = { x = 20 y = 0 }
                orientation = center_left
                centerPosition = yes
                clicksound = "menu_slide_open"
            }
            instantTextBoxType = {
                name = "zone_available"
                font = "font_text_14"
                text = "zone_available"
                position = { x = 40 y = 5 }
                maxWidth = 119
                maxHeight = 93
                fixedSize = yes
                format = center
                vertical_alignment = center
                alwaysTransparent = yes
            }
            instantTextBoxType = {
                name = "zone_unavailable"
                font = "font_text_14"
                text = ""
                position = { x = 5 y = 5 }
                maxWidth = 154
                maxHeight = 93
                fixedSize = yes
                format = center
                vertical_alignment = center
                alwaysTransparent = yes
            }
        }
        # Secondary Zones
        gridBoxType = {
            name = "zones_grid_box"
            position = { x = 410 y = 35 }
            size = { width = 450 height = -10 }
            format = "UPPER_LEFT"
            slotSize = { width = 450 height = @[ 53 * ROW_FACTOR - 1 ] } # Single: 52 | Double: 105
            add_horizontal = yes
            max_slots_horizontal = 1
            #max_slots_vertical = 3
        }
        # GIGA insula info
        effectButtonType = {
            name = insula_info
            position = { x = @info_x_2 y = @info_y }
            size = { x = @info_width y = @info_height }
            effect = giga_birch_structure_info_effect
            no_clicksound = yes
            spriteType = GFX_district_giga_birch_counter_bg
        }
        effectButtonType = {
            name = insula_icon
            position = { x = @[ info_x_2 + info_icon_left ] y = @[ info_y + info_height * 0.5 - info_icon_size * 0.5 ] }
            size = { x = @info_icon_size y = @info_icon_size }
            effect = giga_birch_structure_show_info
            alwaysTransparent = yes
            no_clicksound = yes
            spriteType = GFX_giga_birch_insula_counter
        }
        effectButtonType = {
            name = insula_type_name
            position = { x = @[ info_x_2 + info_icon_left + info_icon_size + 5 ] y = @[ info_y ] }
            size = { x = @[ info_width * info_name_fraction ] y = @info_height }
            effect = giga_birch_structure_show_info
            alwaysTransparent = yes
            no_clicksound = yes
            spriteType = GFX_invisible
            format = left
            vertical_alignment = center
            buttonText = district_giga_birch_structure_info_title
            buttonFont = "font_text_14"
            multiline = yes
        }
        effectButtonType = {
            name = insula_counter
            position = { x = @[ info_x_2 + info_width * (1 - info_value_fraction) ] y = @info_y }
            buttonFont = font_header_20
            buttonText = district_giga_birch_structure_info_value
            effect = giga_birch_structure_show_info
            orientation = upper_left
            format = center
            vertical_alignment = center
            size = { x = @[ info_width * info_value_fraction ] y = @info_height }
            alwaysTransparent = yes
            no_clicksound = yes
            multiline = yes
        }
    }
