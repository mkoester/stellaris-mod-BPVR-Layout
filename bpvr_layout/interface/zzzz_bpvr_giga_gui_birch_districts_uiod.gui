                text = "10"
                position = { x = 0 y = 0 }
                maxWidth = 46
                maxHeight = 28
                fixedSize = yes
                format = center
                vertical_alignment = center
            }
        }
        # Primary Zone
        containerWindowType = {
            name = "zone"
